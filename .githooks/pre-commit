#!/bin/sh
# Scans staged changes for secrets, then lints and formats staged files.
# Enabled by `npm install` (prepare script) or once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed, so the commit was blocked. Install it with: brew install gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner || {
  echo "gitleaks found a possible secret in the staged changes. Remove it before committing." >&2
  exit 1
}

npx --no-install lint-staged
