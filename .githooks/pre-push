#!/bin/sh
# Blocks direct pushes to main. Enable once per clone: git config core.hooksPath .githooks
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct pushes to main are not allowed. Open a pull request instead." >&2
    exit 1
  fi
done
exit 0
