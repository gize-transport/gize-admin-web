# Copy to .env.local for local development. Public values only – this app needs no server secrets.
# Validated when `next dev`, `next build` or `next start` starts (src/lib/public-env.ts): plain
# http is accepted only for localhost. Values are baked into the browser code, so never put a secret here.

# Gize Admin API base URL (local backend: http://localhost:8000)
NEXT_PUBLIC_API_BASE_URL=

# Supabase project used for sign-in: with the local API, the same project as its SUPABASE_URL.
# The anon key is the project's publishable key (public by design).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: error reporting is off when empty
NEXT_PUBLIC_SENTRY_DSN=
