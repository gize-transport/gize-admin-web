// The portal as Cloudflare Workers (GZW-006, GZW-086), built by OpenNext (`npm run cf:build`).
// Two Workers from one config, each built with its own backend settings (GitHub environments):
// - staging (`--env staging`): staging-admin.gizetransport.com, deployed by CI on every merge to
//   main; each PR uploads a version (not deployed) with its own preview address on workers.dev.
// - production (top level): admin.gizetransport.com, released by CI only after an approval.
// See README "Deployment".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gize-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Next.js on Workers needs Node.js APIs.
    "nodejs_compat",
    // The Worker may only fetch public addresses.
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // OpenNext calls the Worker itself (e.g. for middleware); must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gize-admin",
    },
  ],
  // The real address; Cloudflare creates its DNS record and certificate on deploy.
  "routes": [{ "pattern": "admin.gizetransport.com", "custom_domain": true }],
  // No second public address for production, and no preview addresses: PRs preview on staging.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "gize-admin-staging",
      // Not inherited by an environment: named again, for this Worker.
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "gize-admin-staging",
        },
      ],
      // Inherited unless set: this Worker must never claim production's address.
      "routes": [
        { "pattern": "staging-admin.gizetransport.com", "custom_domain": true },
      ],
      "workers_dev": false,
      // Uploaded versions (PR previews) get their own address on workers.dev.
      "preview_urls": true,
    },
  },
}
